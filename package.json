{
  "name": "dsh-remote-control",
  "version": "0.1.0",
  "description": "DSH remote project control, trusted Desired State/runtime sync and Model Gateway bridge",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dsh-remote-host": "bin/dsh-remote-host.mjs",
    "dsh-model-gateway": "bin/dsh-model-gateway.mjs",
    "dsh-remote-host-installer": "bin/dsh-remote-host-installer.mjs",
    "dsh-remote-artifact-installer": "bin/dsh-remote-artifact-installer.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./protocol": "./lib/protocol.mjs",
    "./connector": "./lib/connector.mjs",
    "./connector-identity": "./lib/connector-identity.mjs",
    "./remote-host": "./lib/remote-host.mjs",
    "./gateway": "./lib/gateway.mjs",
    "./ssh": "./lib/ssh.mjs",
    "./bootstrap": "./lib/bootstrap.mjs",
    "./desired-state": "./lib/desired-state.mjs",
    "./runtime-requirement": "./lib/runtime-requirement.mjs",
    "./desired-state-registry": "./lib/desired-state-registry.mjs",
    "./plugin-sync": "./lib/plugin-sync.mjs",
    "./remote-artifact-installer": "./lib/remote-artifact-installer.mjs",
    "./runtime-manager": "./lib/runtime-manager.mjs",
    "./runtime-manager-service": "./lib/runtime-manager-service.mjs"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:stage-a": "node scripts/run-tests.mjs",
    "test:stage-b": "node scripts/run-tests.mjs",
    "test:stage-c": "node scripts/run-tests.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "license": "MIT"
}
